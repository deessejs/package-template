{
  "name": "package-template",
  "version": "1.0.0",
  "description": "TypeScript package template",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deessejs/package-template.git"
  },
  "homepage": "https://github.com/deessejs/package-template#readme",
  "bugs": {
    "url": "https://github.com/deessejs/package-template/issues"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md}\"",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.10.7"
  }
}