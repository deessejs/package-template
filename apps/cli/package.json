{
  "name": "@deessejs/package-cli",
  "version": "0.0.0",
  "description": "CLI for the package-template docs corpus",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "package-cli": "./bin/package-cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deessejs/package-template.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/deessejs/package-template#readme",
  "bugs": {
    "url": "https://github.com/deessejs/package-template/issues"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "typescript",
    "cli",
    "docs"
  ],
  "author": "Nesalia Inc. <hello@nesalia.com>",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}