{
  "$schema": "https://raw.githubusercontent.com/deessejs/deessejs/main/templates/schema/template-v2.json",
  "name": "package-template",
  "slug": "package-starter",
  "title": "Package Starter",
  "description": "A pnpm and Turborepo monorepo with tests, changesets and a publish pipeline, so your library ships on day one.",
  "version": "1.0.0",
  "type": "template:starter",
  "author": "DeesseJS <hello@deessejs.com>",
  "license": "MIT",
  "source": {
    "repo": "deessejs/package-template",
    "ref": "main"
  },
  "requires": {
    "runtime": "node",
    "node": ">=22",
    "packageManager": "pnpm@10.30.3"
  },
  "product": {
    "layer": "open-community",
    "category": "library",
    "labels": ["monorepo", "pnpm", "turborepo", "typescript"],
    "image": "/ship-your-sdk.png"
  },
  "includes": ["**"],
  "excludes": [
    ".changeset/*.md",
    ".claude/settings.local.json",
    ".claude/agent-memory/**",
    ".claude/plans/**",
    ".claude/worktrees/**",
    ".claude/pr-body-*.md",
    ".github/ISSUE_TEMPLATE/**",
    ".github/CODEOWNERS",
    ".github/FUNDING.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "CHANGELOG.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.DS_Store",
    "**/.env",
    "**/.env.*"
  ],
  "fileTypes": {
    "scripts/setup.mjs": "source",
    "README.md": "doc",
    "LICENSE": "doc",
    "CONTRIBUTING.md": "doc",
    "CLAUDE.md": "doc",
    ".changeset/config.json": "config",
    ".husky/pre-commit": "config",
    ".github/workflows/ci.yml": "ci",
    ".github/workflows/release.yml": "ci"
  }
}
