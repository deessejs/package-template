{
  "$schema": "https://registry.deessejs.com/schema/template/v2.json",
  "name": "package-template",
  "title": "Package Template",
  "description": "Production-ready TypeScript monorepo template with pnpm workspaces, Turborepo, Vitest, and changesets.",
  "version": "1.0.0",
  "type": "template:starter",
  "author": "DeesseJS <hello@deessejs.com>",
  "license": "MIT",
  "source": {
    "repo": "deessejs/package-template",
    "ref": "main"
  },
  "requires": {
    "runtime": "node",
    "node": ">=22",
    "packageManager": "pnpm@10"
  },
  "includes": [
    "**"
  ],
  "excludes": [
    ".changeset/*.md",
    ".claude/**",
    "docs/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/CODEOWNERS",
    ".github/FUNDING.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "apps/web/content/docs/**",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.DS_Store",
    "**/.env",
    "**/.env.*"
  ],
  "fileTypes": {
    "scripts/setup.mjs": "source",
    "README.md": "doc",
    "LICENSE": "doc",
    ".changeset/config.json": "config",
    ".husky/pre-commit": "config",
    "public/banner-ds.jpg": "asset"
  }
}
