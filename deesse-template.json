{
  "$schema": "https://app.deessejs.com/schema/template/v1.json",
  "formatVersion": 1,
  "name": "package-template",
  "title": "Package Template",
  "description": "Production-ready TypeScript monorepo template with pnpm workspaces, Turborepo, Vitest, and changesets.",
  "version": "1.0.0",
  "type": "template:starter",
  "author": "DeesseJS <hello@deessejs.com>",
  "license": "MIT",
  "source": {
    "repo": "deessejs/package-template"
  },
  "includes": ["**/*"],
  "excludes": [
    "deesse-template.json",
    ".changeset/*.md",
    ".claude/**",
    "docs/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/CODEOWNERS",
    ".github/FUNDING.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "apps/web/content/docs/**",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.DS_Store",
    "**/.env",
    "**/.env.*"
  ]
}
